    "raw_printing": 0,
    "html": "\n<style>\n@page {\n    size: A4 portrait;\n    margin: 8mm 10mm;\n}\nbody {\n    font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif;\n    color: #1e293b;\n    font-size: 11px;\n    line-height: 1.35;\n    background: #fff;\n    margin: 0;\n    padding: 0;\n}\n.invoice-container {\n    width: 100%;\n    max-width: 100%;\n}\n.inv-header {\n    border-bottom: 2px solid #0d2946;\n    padding-bottom: 8px;\n    margin-bottom: 10px;\n}\n.club-logo {\n    width: 55px;\n    height: 55px;\n    object-fit: contain;\n}\n.club-title {\n    font-size: 16px;\n    font-weight: 800;\n    color: #0d2946;\n    letter-spacing: 0.5px;\n    text-transform: uppercase;\n    margin-bottom: 2px;\n}\n.club-subtitle {\n    font-size: 10px;\n    color: #64748b;\n    margin-bottom: 1px;\n}\n.inv-badge-title {\n    font-size: 15px;\n    font-weight: 800;\n    color: #0d2946;\n    text-align: right;\n    margin-bottom: 2px;\n}\n.inv-meta-table {\n    font-size: 10.5px;\n    margin-left: auto;\n}\n.inv-meta-table td {\n    padding: 1px 4px;\n}\n.inv-box {\n    background: #f8fafc;\n    border: 1px solid #e2e8f0;\n    border-radius: 6px;\n    padding: 8px 12px;\n    margin-bottom: 10px;\n}\n.inv-box-title {\n    font-size: 9.5px;\n    font-weight: 700;\n    color: #64748b;\n    text-transform: uppercase;\n    letter-spacing: 0.5px;\n    margin-bottom: 4px;\n}\n.inv-items-table {\n    width: 100%;\n    border-collapse: collapse;\n    margin-bottom: 10px;\n}\n.inv-items-table th {\n    background: #0d2946;\n    color: #ffffff;\n    font-size: 10px;\n    font-weight: 700;\n    text-transform: uppercase;\n    letter-spacing: 0.5px;\n    padding: 6px 8px;\n    border: 1px solid #0d2946;\n}\n.inv-items-table td {\n    padding: 6px 8px;\n    border: 1px solid #e2e8f0;\n    font-size: 10.5px;\n}\n.inv-items-table tr:nth-child(even) td {\n    background: #fcfcfd;\n}\n.totals-table {\n    width: 280px;\n    margin-left: auto;\n    border-collapse: collapse;\n    font-size: 11px;\n}\n.totals-table td {\n    padding: 3px 6px;\n}\n.grand-total-row td {\n    border-top: 1.5px solid #0d2946;\n    border-bottom: 1.5px solid #0d2946;\n    font-weight: 800;\n    font-size: 12px;\n    color: #0d2946;\n    padding-top: 5px;\n    padding-bottom: 5px;\n}\n.upi-pay-box {\n    background: #f0fdf4;\n    border: 1px dashed #22c55e;\n    border-radius: 6px;\n    padding: 8px 10px;\n    font-size: 10px;\n}\n.inv-footer {\n    border-top: 1px solid #e2e8f0;\n    padding-top: 6px;\n    margin-top: 10px;\n    font-size: 9px;\n    color: #94a3b8;\n    text-align: center;\n}\n</style>\n\n<div class=\"invoice-container\">\n    <!-- Header -->\n    <table style=\"width: 100%;\" class=\"inv-header\">\n        <tr>\n            <td style=\"width: 65px; vertical-align: middle;\">\n                <img src=\"/files/1000333700.png\" class=\"club-logo\" alt=\"ROC\">\n            </td>\n            <td style=\"vertical-align: middle;\">\n                <div class=\"club-title\">The Railway Officers' Club</div>\n                <div class=\"club-subtitle\">Sterling Road, Nungambakkam, Chennai - 600034</div>\n                <div class=\"club-subtitle\">Affiliated with Southern Railway Officers' Association</div>\n            </td>\n            <td style=\"vertical-align: middle; text-align: right;\">\n                <div class=\"inv-badge-title\">TAX INVOICE</div>\n                <table class=\"inv-meta-table\">\n                    <tr>\n                        <td style=\"color: #64748b; text-align: right;\">Invoice No:</td>\n                        <td style=\"font-weight: 700; color: #0d2946;\">{{ doc.name }}</td>\n                    </tr>\n                    <tr>\n                        <td style=\"color: #64748b; text-align: right;\">Date:</td>\n                        <td style=\"font-weight: 600;\">{{ frappe.utils.format_date(doc.posting_date) }}</td>\n                    </tr>\n                    <tr>\n                        <td style=\"color: #64748b; text-align: right;\">Due Date:</td>\n                        <td style=\"font-weight: 600; color: #b91c1c;\">{{ frappe.utils.format_date(doc.due_date) if doc.due_date else \"-\" }}</td>\n                    </tr>\n                </table>\n            </td>\n        </tr>\n    </table>\n\n    <!-- Member Details & Status Summary -->\n    <table style=\"width: 100%; margin-bottom: 10px;\">\n        <tr>\n            <td style=\"width: 58%; vertical-align: top; padding-right: 8px;\">\n                <div class=\"inv-box\">\n                    <div class=\"inv-box-title\">Billed To (Member Details)</div>\n                    <div style=\"font-size: 12px; font-weight: 800; color: #0d2946; margin-bottom: 2px;\">\n                        {{ doc.customer_name }}\n                    </div>\n                    <div><strong>Member ID:</strong> <span style=\"color: #c59b27; font-weight: 700;\">{{ doc.customer }}</span></div>\n                    {% if doc.contact_mobile %}\n                    <div><strong>Mobile:</strong> {{ doc.contact_mobile }}</div>\n                    {% endif %}\n                    {% if doc.contact_email %}\n                    <div><strong>Email:</strong> {{ doc.contact_email }}</div>\n                    {% endif %}\n                </div>\n            </td>\n            <td style=\"width: 42%; vertical-align: top; padding-left: 8px;\">\n                <div class=\"inv-box\" style=\"height: 100%;\">\n                    <div class=\"inv-box-title\">Invoice & Payment Status</div>\n                    <div><strong>Status:</strong> \n                        {% if doc.outstanding_amount == 0 %}\n                            <span style=\"color: #15803d; font-weight: 700;\">PAID & CLEARED</span>\n                        {% else %}\n                            <span style=\"color: #b91c1c; font-weight: 700;\">PAYMENT DUE</span>\n                        {% endif %}\n                    </div>\n                    <div><strong>Reconciliation:</strong> {{ doc.custom_reconciliation_status or \"Pending Payment\" }}</div>\n                    {% if doc.custom_upi_utr %}\n                    <div><strong>UTR Ref:</strong> <code>{{ doc.custom_upi_utr }}</code></div>\n                    {% endif %}\n                    <div style=\"margin-top: 4px; font-size: 10px; color: #64748b;\">\n                        Unique VPA: <strong style=\"color: #0d2946;\">roc{{ doc.customer }}@fbl</strong>\n                    </div>\n                </div>\n            </td>\n        </tr>\n    </table>\n\n    <!-- Line Items Table -->\n    <table class=\"inv-items-table\">\n        <thead>\n            <tr>\n                <th style=\"width: 35px; text-align: center;\">#</th>\n                <th>Item & Description</th>\n                <th style=\"width: 60px; text-align: center;\">Qty</th>\n                <th style=\"width: 85px; text-align: right;\">Rate (\u20b9)</th>\n                <th style=\"width: 95px; text-align: right;\">Amount (\u20b9)</th>\n            </tr>\n        </thead>\n        <tbody>\n            {% for item in doc.items %}\n            <tr>\n                <td style=\"text-align: center; color: #64748b;\">{{ loop.index }}</td>\n                <td>\n                    <div style=\"font-weight: 700; color: #0f172a;\">{{ item.item_name or item.item_code }}</div>\n                    {% if item.description and item.description != item.item_name %}\n                    <div style=\"font-size: 9.5px; color: #64748b;\">{{ item.description }}</div>\n                    {% endif %}\n                </td>\n                <td style=\"text-align: center;\">{{ item.qty }}</td>\n                <td style=\"text-align: right;\">{{ \"{:,.2f}\".format(item.rate) }}</td>\n                <td style=\"text-align: right; font-weight: 600;\">{{ \"{:,.2f}\".format(item.amount) }}</td>\n            </tr>\n            {% endfor %}\n        </tbody>\n    </table>\n\n    <!-- Lower Section: UPI Info + Totals -->\n    <table style=\"width: 100%;\">\n        <tr>\n            <td style=\"width: 52%; vertical-align: top; padding-right: 12px;\">\n                <div class=\"upi-pay-box\">\n                    <div style=\"font-weight: 700; color: #166534; font-size: 10.5px; margin-bottom: 2px;\">\n                        \u26a1 Quick UPI Payment via Federal Bank:\n                    </div>\n                    <div>Pay directly via Google Pay / PhonePe / Paytm / BHIM to:</div>\n                    <div style=\"font-size: 12px; font-weight: 800; color: #0d2946; margin: 3px 0;\">\n                        roc{{ doc.customer }}@fbl\n                    </div>\n                    <div style=\"color: #64748b; font-size: 9px;\">\n                        \u2022 Zero Gateway Convenience Fee &bull; Auto-reconciled with member ledger.\n                    </div>\n                </div>\n            </td>\n            <td style=\"width: 48%; vertical-align: top;\">\n                <table class=\"totals-table\">\n                    <tr>\n                        <td style=\"color: #64748b;\">Subtotal (Net):</td>\n                        <td style=\"text-align: right; font-weight: 600;\">\u20b9{{ \"{:,.2f}\".format(doc.net_total) }}</td>\n                    </tr>\n                    {% for tax in doc.taxes %}\n                    {% if tax.tax_amount > 0 %}\n                    <tr>\n                        <td style=\"color: #64748b; font-size: 10px;\">{{ tax.account_head.split(\" - \")[0] }}:</td>\n                        <td style=\"text-align: right; font-size: 10px;\">\u20b9{{ \"{:,.2f}\".format(tax.tax_amount) }}</td>\n                    </tr>\n                    {% endif %}\n                    {% endfor %}\n                    <tr class=\"grand-total-row\">\n                        <td>Total Amount:</td>\n                        <td style=\"text-align: right;\">\u20b9{{ \"{:,.2f}\".format(doc.grand_total) }}</td>\n                    </tr>\n                    {% if doc.total_advance > 0 %}\n                    <tr>\n                        <td style=\"color: #15803d; font-size: 10px;\">Advance Paid:</td>\n                        <td style=\"text-align: right; font-size: 10px; color: #15803d;\">- \u20b9{{ \"{:,.2f}\".format(doc.total_advance) }}</td>\n                    </tr>\n                    {% endif %}\n                    <tr>\n                        <td style=\"font-weight: 800; color: #b91c1c; padding-top: 4px;\">Outstanding Balance:</td>\n                        <td style=\"text-align: right; font-weight: 800; color: #b91c1c; font-size: 12px; padding-top: 4px;\">\n                            \u20b9{{ \"{:,.2f}\".format(doc.outstanding_amount) }}\n                        </td>\n                    </tr>\n                </table>\n            </td>\n        </tr>\n    </table>\n\n    <!-- Footer -->\n    <div class=\"inv-footer\">\n        This is a computer-generated invoice issued by The Railway Officers' Club, Chennai. For queries, contact the Club Office or email support@railwayofficersclub.in.\n    </div>\n</div>\n",
